; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Snekfud"
run/main_scene="res://Main_Menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GlobalState="*res://global_state.gd"
AudioManager="*res://audio_manager.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=640
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/scale_mode="keep"

[layer_names]

2d_physics/layer_1="snake_head"
2d_physics/layer_2="interactables"
2d_physics/layer_3="snake_body"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
